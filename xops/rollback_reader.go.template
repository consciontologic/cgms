package main

import (
 "context"
 "fmt"
 "io"
 "os"
 "strings"
 "time"
 "github.com/jackc/pgx/v5/pgxpool"
 "github.com/metaphy6/cgms/backend/internal/game"
 "github.com/metaphy6/cgms/backend/internal/matchstore"
)
func main(){
 ctx,cancel:=context.WithTimeout(context.Background(),10*time.Second);defer cancel()
 pool,err:=pgxpool.New(ctx,os.Getenv("CGMS_ROLLBACK_DATABASE_URL"));if err!=nil {os.Exit(1)};defer pool.Close()
 if err=matchstore.Up(ctx,pool);err!=nil {fmt.Println("unsupported migration");os.Exit(2)}
 state,_,err:=matchstore.New(pool,"rules-test").Restore(ctx,"m");if err!=nil {fmt.Println("unsupported checkpoint");os.Exit(3)}
 expected,err:=io.ReadAll(io.LimitReader(os.Stdin,256));if err!=nil || strings.TrimSpace(string(expected))!=game.Digest(state) {fmt.Println("state mismatch");os.Exit(4)}
 fmt.Println("compatible pinned checkpoint")
}
