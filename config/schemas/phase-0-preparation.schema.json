{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CGMS Phase 0 preparation inputs - NOT runtime configuration",
  "description": "Preparation structure only. Semantic validation and runtime promotion remain required.",
  "oneOf": [
    {
      "$ref": "#/$defs/scenario"
    },
    {
      "$ref": "#/$defs/experiment"
    },
    {
      "$ref": "#/$defs/replay-vector"
    }
  ],
  "$defs": {
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "string",
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "maxLength": 256
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 256
        }
      },
      "required": [
        "numerator",
        "denominator"
      ]
    },
    "seatLedger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "score": {
          "$ref": "#/$defs/rational"
        },
        "available": {
          "$ref": "#/$defs/rational"
        }
      },
      "required": [
        "seat",
        "score",
        "available"
      ]
    },
    "debt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "debtor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "creditor": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            {
              "const": "system"
            }
          ]
        },
        "amount": {
          "$ref": "#/$defs/rational"
        },
        "charge_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        }
      },
      "required": [
        "id",
        "sequence",
        "debtor",
        "creditor",
        "amount",
        "charge_id"
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "seat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "amount": {
          "$ref": "#/$defs/rational"
        }
      },
      "required": [
        "id",
        "seat",
        "amount"
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "preparation-only"
        },
        "runtime_validated": {
          "const": false
        },
        "schema_version": {
          "const": "cgms-preparation-v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "kind": {
          "const": "scenario"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "fixture_type": {
          "const": "accounting-only"
        },
        "rule_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 1,
          "maxItems": 40
        },
        "players": {
          "enum": [
            3,
            4
          ]
        },
        "initial_ledgers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/seatLedger"
          },
          "minItems": 3,
          "maxItems": 4
        },
        "debts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/debt"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/receipt"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ledgers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/seatLedger"
              },
              "minItems": 3,
              "maxItems": 4
            },
            "remaining_debts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/debt"
              },
              "minItems": 0,
              "maxItems": 100
            },
            "reference_payment_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "scenario_status": {
              "const": "scenario-complete"
            },
            "game_complete": {
              "const": false
            }
          },
          "required": [
            "ledgers",
            "remaining_debts",
            "reference_payment_count",
            "scenario_status",
            "game_complete"
          ]
        }
      },
      "required": [
        "status",
        "runtime_validated",
        "schema_version",
        "id",
        "kind",
        "purpose",
        "fixture_type",
        "rule_refs",
        "players",
        "initial_ledgers",
        "debts",
        "receipts",
        "expected"
      ]
    },
    "bot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "participant_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "policy": {
          "enum": [
            "legal-random",
            "heuristic"
          ]
        },
        "version": {
          "const": "v1-planned"
        },
        "information": {
          "const": "seat-projection"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "minItems": 0,
          "maxItems": 20
        },
        "weights": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -10000,
            "maximum": 10000
          },
          "minItems": 0,
          "maxItems": 20
        }
      },
      "required": [
        "participant_id",
        "policy",
        "version",
        "information",
        "features",
        "weights"
      ]
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "preparation-only"
        },
        "runtime_validated": {
          "const": false
        },
        "schema_version": {
          "const": "cgms-preparation-v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "kind": {
          "const": "experiment"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "population": {
          "enum": [
            3,
            4
          ]
        },
        "phase": {
          "const": "development-pilot"
        },
        "claim_scope": {
          "const": "partial-scenario-only"
        },
        "rules_profile": {
          "const": "accepted-game-rules"
        },
        "interpretation_replacements": {
          "type": "array",
          "maxItems": 0
        },
        "engine_version": {
          "const": "not-implemented"
        },
        "required_coverage": {
          "type": "array",
          "items": {
            "enum": [
              "S04",
              "S05",
              "S06",
              "S07"
            ]
          },
          "minItems": 1,
          "maxItems": 4
        },
        "pairing_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "root_seed": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 78
        },
        "block_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true
        },
        "games_per_match": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "match_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "bots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bot"
          },
          "minItems": 3,
          "maxItems": 4
        },
        "candidate": {
          "$ref": "#/$defs/bot"
        },
        "rotation_policy": {
          "enum": [
            "complete-cyclic",
            "all-permutations"
          ]
        },
        "rotations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "seats": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                },
                "minItems": 3,
                "maxItems": 4
              }
            },
            "required": [
              "id",
              "seats"
            ]
          },
          "minItems": 3,
          "maxItems": 24
        },
        "grid": {
          "type": "array",
          "maxItems": 0
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "workers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "max_matches": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "max_transitions_per_match": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "max_settlement_steps_per_match": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "max_bot_operations_per_decision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "max_output_bytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 1073741824
            },
            "max_input_bytes": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 16777216
            },
            "max_input_rational_digits": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "wall_watchdog_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            }
          },
          "required": [
            "workers",
            "max_matches",
            "max_transitions_per_match",
            "max_settlement_steps_per_match",
            "max_bot_operations_per_decision",
            "max_output_bytes",
            "max_input_bytes",
            "max_input_rational_digits",
            "wall_watchdog_seconds"
          ]
        },
        "analysis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": "cgms-analysis-v1"
            },
            "root_seed": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 78
            },
            "primary_metric": {
              "const": "paired-final-match-score"
            },
            "resamples": {
              "const": 10000
            },
            "confidence_percent": {
              "const": 95
            },
            "cluster": {
              "const": "seed-block"
            },
            "incomplete_policy": {
              "const": "report-all-complete-pairs-only"
            }
          },
          "required": [
            "version",
            "root_seed",
            "primary_metric",
            "resamples",
            "confidence_percent",
            "cluster",
            "incomplete_policy"
          ]
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "root": {
              "const": "sims/artifacts"
            },
            "private_replay": {
              "const": true
            },
            "report_observer": {
              "const": "public"
            },
            "omniscient_comparison": {
              "const": false
            }
          },
          "required": [
            "root",
            "private_replay",
            "report_observer",
            "omniscient_comparison"
          ]
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "days": {
              "const": 30
            },
            "review_hold": {
              "type": "boolean"
            },
            "prune": {
              "const": "preview-before-delete"
            }
          },
          "required": [
            "days",
            "review_hold",
            "prune"
          ]
        }
      },
      "required": [
        "status",
        "runtime_validated",
        "schema_version",
        "id",
        "kind",
        "purpose",
        "population",
        "phase",
        "claim_scope",
        "rules_profile",
        "interpretation_replacements",
        "engine_version",
        "required_coverage",
        "pairing_id",
        "root_seed",
        "block_ids",
        "games_per_match",
        "match_index",
        "bots",
        "candidate",
        "rotation_policy",
        "rotations",
        "grid",
        "budgets",
        "analysis",
        "output",
        "retention"
      ]
    },
    "replay-vector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "preparation-only"
        },
        "runtime_validated": {
          "const": false
        },
        "schema_version": {
          "const": "cgms-preparation-v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "kind": {
          "const": "replay-vector"
        },
        "scope": {
          "const": "encoding-and-derivation-only"
        },
        "canonicalization": {
          "const": "cgms-canonical-v1"
        },
        "vectors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "input_json": {
                "type": "string",
                "maxLength": 4096
              },
              "canonical_utf8": {
                "type": "string",
                "maxLength": 4096
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "label",
              "input_json",
              "canonical_utf8",
              "sha256"
            ]
          },
          "minItems": 1,
          "maxItems": 20
        },
        "seed_tuple_json": {
          "type": "string",
          "maxLength": 4096
        },
        "derived_seed_hex": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prng_words_validated": {
          "const": false
        }
      },
      "required": [
        "status",
        "runtime_validated",
        "schema_version",
        "id",
        "kind",
        "scope",
        "canonicalization",
        "vectors",
        "seed_tuple_json",
        "derived_seed_hex",
        "prng_words_validated"
      ]
    }
  }
}
