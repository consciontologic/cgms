{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CGMS service configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "listen",
    "origin",
    "insecure_local",
    "rules_file",
    "database_url_file",
    "observability"
  ],
  "properties": {
    "economy_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Explicitly enable the adopted local dirt and pass policy; does not activate a store provider."
    },
    "version": {
      "const": 1
    },
    "listen": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "format": "uri"
    },
    "insecure_local": {
      "type": "boolean"
    },
    "rules_file": {
      "type": "string",
      "minLength": 1
    },
    "database_url_file": {
      "type": "string",
      "minLength": 1
    },
    "redis_url_file": {
      "type": "string"
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "endpoint"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string"
        }
      }
    },
    "proxy_client_ip": {
      "type": "boolean",
      "description": "Trust X-Real-IP only on an isolated backend behind a proxy which overwrites this header."
    },
    "max_streams": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096,
      "default": 64
    }
  }
}
